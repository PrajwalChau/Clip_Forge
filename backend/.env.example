NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/clipforge
JWT_SECRET=replace-with-a-random-32-byte-secret
COOKIE_SECURE=false
# Must be true behind HTTPS in production.
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
QUEUE_MODE=bullmq
# Use embedded for the small local setup; use separate in production with npm run worker.
WORKER_MODE=embedded
WORKER_CONCURRENCY=1
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=14400
MAX_OUTPUT_BYTES=1073741824
MAX_CLIPS_PER_JOB=5
TEMP_FILE_MAX_AGE_HOURS=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_COMMAND=whisper
WHISPER_MODEL=base
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
AI_PROVIDER=none
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VIDEO_PROCESSING_MODE=real
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
PAYMENTS_MODE=disabled
# Social Accounts & Automated Publishing (Optional)
# Optional 32-byte encryption key for securing stored OAuth tokens (defaults to hash of JWT_SECRET)
TOKEN_ENCRYPTION_KEY=
# YouTube Data API v3 & OAuth 2.0 (for YouTube Shorts publishing)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5173/app/social
# TikTok Content Posting API (for TikTok publishing)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/app/social
# Meta Graph API (for Instagram Reels & Facebook Reels publishing)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5173/app/social
